{
  "name": "clickfix-guard",
  "version": "1.0.0",
  "private": true,
  "description": "Browser extension (Chrome + Firefox) that blocks ClickFix / fake-CAPTCHA paste-and-run attacks.",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/",
    "e2e": "node test/e2e.mjs",
    "build": "python3 tools/build.py",
    "lint:firefox": "python3 tools/build.py && npx --yes addons-linter --self-hosted dist/*-firefox.xpi",
    "train": "node ml/train.mjs",
    "eval": "node ml/evaluate.mjs"
  }
}
